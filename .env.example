# Copie para .env e preencha o que for usar. O .env e ignorado pelo git.
# Como obter cada credencial: veja o README.md.

# Comando "edi" — API do Extrato EDI.
# Ativacao por chamado no Pipefy, opcao "Novas Ativacoes - EDI".
PAGBANK_EDI_USER=
PAGBANK_EDI_TOKEN=

# Comando "transacoes" — API legada. Token gerado no painel do vendedor,
# em Preferencias > Integracoes > Token de seguranca. Nao e a senha da conta.
PAGBANK_EMAIL=
PAGBANK_TOKEN=
